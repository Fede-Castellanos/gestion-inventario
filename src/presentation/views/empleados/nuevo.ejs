<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge-fill me-2 text-primary"></i> Registrar Empleado</h4>
                <a href="/empleados" class="btn btn-outline-secondary btn-sm">Volver</a>
            </div>
            <div class="card-body p-4">
                <form method="POST" action="/empleados/nuevo">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Número de Legajo / ID (Opcional)</label>
                        <input type="number" name="id" class="form-control" placeholder="Ej: 4436 (Dejar en blanco para autogenerar)" value="<%= formData.id || '' %>">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Roberto" value="<%= formData.nombre || '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Apellido <span class="text-danger">*</span></label>
                            <input type="text" name="apellido" class="form-control" placeholder="Ej: González" value="<%= formData.apellido || '' %>" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Puesto Jerárquico <span class="text-danger">*</span></label>
                        <select name="puesto" class="form-select" required>
                            <option value="Gerente" <%= formData.puesto === 'Gerente' ? 'selected' : '' %>>Gerente (Autorizado para carga y caja)</option>
                            <option value="Supervisor" <%= formData.puesto === 'Supervisor' ? 'selected' : '' %>>Supervisor (Autorizado para carga de inventario)</option>
                            <option value="Cajero" <%= formData.puesto === 'Cajero' ? 'selected' : '' %>>Cajero (Autorizado para operar caja y ventas)</option>
                            <option value="Operario" <%= formData.puesto === 'Operario' ? 'selected' : '' %>>Operario (Sin permisos administrativos)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Zona Asignada</label>
                        <input type="text" name="zonaAsignada" class="form-control" placeholder="Ej: Pasillo Central o Línea de Cajas" value="<%= formData.zonaAsignada || '' %>">
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fecha de Ingreso <span class="text-danger">*</span></label>
                            <input type="date" name="fechaIngreso" class="form-control" value="<%= formData.fechaIngreso || new Date().toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Salario Mensual ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="0" name="salario" class="form-control" placeholder="85000.00" value="<%= formData.salario || '' %>" required>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/empleados" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Guardar Empleado
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
