<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i> Registrar Nuevo Producto en Inventario</h4>
                <a href="/productos" class="btn btn-outline-secondary btn-sm">Volver al catálogo</a>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                    <div>
                        <strong>Reglas de Dominio y Seguridad:</strong>
                        <ul class="mb-0 small ps-3">
                            <li>Solo empleados con puesto de <strong>Gerente</strong> o <strong>Supervisor</strong> están autorizados a ingresar productos al inventario.</li>
                            <li><strong>Compatibilidad térmica estricta:</strong> Los productos fríos solo pueden guardarse en zonas refrigeradas; los calientes/secos en zonas no refrigeradas.</li>
                            <li>La zona no debe haber alcanzado su <strong>capacidad máxima</strong>.</li>
                        </ul>
                    </div>
                </div>

                <form method="POST" action="/productos/nuevo" id="formProducto">
                    <!-- Sección 1: Autorización del Empleado -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">1. Responsable de la Carga (Validación de Jerarquía)</h5>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Empleado que autoriza el ingreso <span class="text-danger">*</span></label>
                        <select name="empleadoId" class="form-select" required>
                            <option value="">-- Seleccionar Empleado --</option>
                            <% empleados.forEach(e => { %>
                                <option value="<%= e.getId() %>" <%= formData.empleadoId == e.getId() ? 'selected' : '' %>>
                                    <%= e.getNombreCompleto() %> — Puesto: <%= e.getPuesto() %> <%= (e.getPuesto() === 'Gerente' || e.getPuesto() === 'Supervisor') ? '✅ (Autorizado)' : '❌ (Sin permisos)' %>
                                </option>
                            <% }) %>
                        </select>
                        <div class="form-text">Si seleccionas un Operario o Cajero, el motor de negocio rechazará la operación por fallo de seguridad.</div>
                    </div>

                    <!-- Sección 2: Datos Generales del Producto -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">2. Información del Producto</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nombre del Producto <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Arroz Integral 1kg" value="<%= formData.nombre || '' %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Código de Barras <span class="text-danger">*</span></label>
                            <input type="text" name="codigoBarras" class="form-control" placeholder="Ej: 7791234567890" value="<%= formData.codigoBarras || '' %>" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Número de Lote <span class="text-danger">*</span></label>
                            <input type="text" name="numeroDeLote" class="form-control" placeholder="Ej: L-2026-X" value="<%= formData.numeroDeLote || '' %>" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tipo / Clasificación <span class="text-danger">*</span></label>
                            <select name="tipo" class="form-select" required>
                                <option value="perecedero" <%= formData.tipo === 'perecedero' ? 'selected' : '' %>>Perecedero</option>
                                <option value="no perecedero" <%= formData.tipo === 'no perecedero' ? 'selected' : '' %>>No Perecedero</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">País de Origen <span class="text-danger">*</span></label>
                            <input type="text" name="paisDeOrigen" class="form-control" placeholder="Ej: Argentina, Brasil, Uruguay" value="<%= formData.paisDeOrigen || '' %>" required>
                            <div class="form-text">Determina las políticas de descuentos en las ventas.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Productor / Marca <span class="text-danger">*</span></label>
                            <input type="text" name="productor" class="form-control" placeholder="Ej: Molinos, Conaprole" value="<%= formData.productor || '' %>" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Precio Unitario ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="0" name="precio" class="form-control" placeholder="0.00" value="<%= formData.precio || '' %>" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cantidad Inicial (Stock) <span class="text-danger">*</span></label>
                            <input type="number" min="1" name="cantidad" class="form-control" placeholder="Ej: 50" value="<%= formData.cantidad || 1 %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha de Caducidad <span class="text-danger">*</span></label>
                            <input type="date" name="caducidad" class="form-control" value="<%= formData.caducidad || '' %>" required>
                        </div>
                    </div>

                    <!-- Sección 3: Térmica y Asignación de Zona -->
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">3. Configuración Térmica y Almacenamiento</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Requerimiento Térmico <span class="text-danger">*</span></label>
                            <select name="esFrio" id="esFrioSelect" class="form-select" onchange="toggleTemperatura()" required>
                                <option value="0" <%= formData.esFrio === '0' ? 'selected' : '' %>>Seco / Ambiente (Producto Caliente)</option>
                                <option value="1" <%= formData.esFrio === '1' ? 'selected' : '' %>>Refrigerado (Producto Frío)</option>
                            </select>
                        </div>

                        <div class="col-md-4" id="divTemperatura" style="<%= formData.esFrio === '1' ? '' : 'display: none;' %>">
                            <label class="form-label fw-semibold">Temperatura Recomendada (°C)</label>
                            <div class="input-group">
                                <input type="number" step="0.1" name="temperaturaRecomendada" id="tempInput" class="form-control" placeholder="Ej: 4.0" value="<%= formData.temperaturaRecomendada || 4 %>">
                                <span class="input-group-text">°C</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Zona de Almacenamiento <span class="text-danger">*</span></label>
                            <select name="zonaId" class="form-select" required>
                                <option value="">-- Seleccionar Zona --</option>
                                <% zonas.forEach(z => { %>
                                    <option value="<%= z.zona.getId() %>" <%= formData.zonaId == z.zona.getId() ? 'selected' : '' %>>
                                        <%= z.zona.getNombre() %> [<%= z.zona.getEsRefrigerada() ? '❄️ Refrigerada' : '☀️ Secos' %>] (Ocupación: <%= z.cantidadOcupada %>/<%= z.capacidadMaxima %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/productos" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Guardar en Inventario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function toggleTemperatura() {
    const select = document.getElementById('esFrioSelect');
    const divTemp = document.getElementById('divTemperatura');
    if (select.value === '1') {
        divTemp.style.display = 'block';
    } else {
        divTemp.style.display = 'none';
    }
}
</script>

<%- include('../partials/footer') %>
